# ---------------------------------------------------------------------------
# Nara Web - contoh konfigurasi lingkungan
# Salin menjadi .env lalu sesuaikan. File .env TIDAK di-commit (lihat .gitignore).
# Semua nilai di bawah di-baca oleh Vite (prefix VITE_).
# ---------------------------------------------------------------------------

# Mode adapter autentikasi.
#   dummy = data palsu di localStorage (untuk demo / pengembangan)
#   http  = pemanggilan ke backend sungguhan (lihat src/lib/auth/httpAuthApi.ts)
VITE_AUTH_MODE=dummy

# Di build production, mode "dummy" hanya aktif bila nilai ini "true".
# Jika "false"/kosong, /login dan /register menampilkan halaman
# "Autentikasi belum diaktifkan" agar build produksi tidak memakai akun demo.
# Di mode dev nilainya diabaikan (dummy selalu boleh).
VITE_ALLOW_DUMMY_AUTH=true

# Mode API chat.
#   mock = balasan contoh lokal (default di dev), tanpa jaringan
#   http = POST ke /api/chat
VITE_CHAT_MODE=mock

# Jika "true", tamu yang membuka /chat diarahkan ke /login?next=/chat.
VITE_CHAT_REQUIRES_LOGIN=false
